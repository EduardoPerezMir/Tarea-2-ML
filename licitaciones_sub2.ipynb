      "source": [
        "## 14. Evaluación final reservada: noviembre–diciembre\n",
        "Se aplica el mismo modelo y el umbral ya fijado. Mostramos también el resultado con 0,5 y las dos reglas triviales para entender la mejora. **Estas referencias no se usan para escoger retrospectivamente otro umbral o modelo.**\n",
        "\n",
        "La matriz de confusión permite distinguir desiertas detectadas, desiertas omitidas y falsas alarmas. Se estima además un intervalo aproximado para F1 mediante remuestreo de semanas (300 repeticiones), manteniendo juntos los casos de una misma semana. El intervalo refleja variabilidad en este período, no incertidumbre por volver a entrenar ni posibles cambios en 2025."
      ]
    },
    {
      "cell_type": "code",
      "id": "953c89e1",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 774
        },
        "id": "953c89e1",
        "outputId": "e93f9149-ad3c-44ac-d2c6-4d06e8c6dd2a"
      },
      "source": [
        "p_eval=predecir_seleccion(modelos_validacion,X.loc[evaluacion.index])\n",
        "y_eval=evaluacion[TARGET].to_numpy()\n",
        "metricas_finales=medir(y_eval,p_eval,umbral_final)\n",
        "tabla_evaluacion=pd.DataFrame([\n",
        "    {'regla':'Modelo con umbral fijado',**metricas_finales},\n",
        "    {'regla':'Mismo modelo con 0.5',**medir(y_eval,p_eval,.5)},\n",
        "    {'regla':'Siempre no desierta',**medir(y_eval,np.zeros(len(y_eval)),.5)},\n",
        "    {'regla':'Siempre desierta',**medir(y_eval,np.ones(len(y_eval)),.5)}]).set_index('regla')\n",
        "display(tabla_evaluacion)\n",
        "pred_eval=(p_eval>=umbral_final).astype(int)\n",
        "cm=confusion_matrix(y_eval,pred_eval,labels=[0,1])\n",
        "display(pd.DataFrame(cm,index=['Real no desierta','Real desierta'],\n",
        "                     columns=['Predice no desierta','Predice desierta']))\n",
        "fig,ax=plt.subplots(figsize=(5,3.7)); ax.imshow(cm,cmap='Blues')\n",
        "for i in range(2):\n",
        "    for j in range(2): ax.text(j,i,str(cm[i,j]),ha='center',va='center',\n",
        "                              color='white' if cm[i,j]>cm.max()/2 else 'black')\n",
        "ax.set_xticks([0,1],['No desierta','Desierta']); ax.set_yticks([0,1],['No desierta','Desierta'])\n",
        "ax.set_xlabel('Predicción'); ax.set_ylabel('Real'); plt.tight_layout(); plt.show()\n",
        "semanas=evaluacion.pub_fecha.dt.strftime('%G-%V').to_numpy()\n",
        "grupos_semana=[np.flatnonzero(semanas==s) for s in np.unique(semanas)]\n",
        "rng=np.random.default_rng(SEMILLA); f1_boot=[]\n",
        "for _ in range(300):\n",
        "    ix=np.concatenate([grupos_semana[k] for k in rng.integers(len(grupos_semana),size=len(grupos_semana))])\n",
        "    f1_boot.append(f1_score(y_eval[ix],pred_eval[ix],zero_division=0))\n",
        "ic_f1=np.quantile(f1_boot,[.025,.975])\n",
        "print('Intervalo aproximado 95% de F1 (semanas):',np.round(ic_f1,4))\n",
        "filas_periodo=[]\n",
        "meses=evaluacion.pub_fecha.dt.strftime('%Y-%m').to_numpy()\n",
        "for mes in sorted(set(meses)):\n",
        "    ix=meses==mes\n",
        "    filas_periodo.append({'mes':mes,'filas':int(ix.sum()),**medir(y_eval[ix],p_eval[ix],umbral_final)})\n",
        "display(pd.DataFrame(filas_periodo)[['mes','filas','f1','precision','recall','ap']])"
      ],
      "execution_count": null,
