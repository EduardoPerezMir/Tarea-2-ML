      "source": [
        "opciones_arboles = {\n",
        "    f'H_hojas{h}_min{m}_iter{i}':dict(familia='arboles',variables='ampliadas',\n",
        "        max_leaf_nodes=h,min_samples_leaf=m,max_iter=i,learning_rate=.08,l2_regularization=10.)\n",
        "    for h in [15,31] for m in [30,100] for i in [150,300]}\n",
        "tabla_arboles = comparar(opciones_arboles,ventanas,resultados,predicciones,registro)\n",
        "display(tabla_arboles)"
      ],
