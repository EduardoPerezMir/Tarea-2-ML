      "source": [
        "RUTA_DATOS = Path('/content')\n",
        "def buscar_csv(nombre):\n",
        "    opciones = [RUTA_DATOS/f'{nombre}.csv', RUTA_DATOS/f'{nombre}(1).csv']\n",
        "    encontrados = [p for p in opciones if p.exists()]\n",
        "    if not encontrados:\n",
        "        raise FileNotFoundError(f'Falta {nombre}.csv. Súbelo antes de continuar.')\n",
        "    return encontrados[0]\n",
        "\n",
        "tipos_id = {'id':str, 'comprador_id':str, 'comprador_rut':str}\n",
        "rutas = {n:buscar_csv(n) for n in ['train','test','sample_submission']}\n",
        "datos = pd.read_csv(rutas['train'], dtype=tipos_id)\n",
        "test = pd.read_csv(rutas['test'], dtype=tipos_id)\n",
        "plantilla = pd.read_csv(rutas['sample_submission'], dtype={'id':str})\n",
        "\n",
        "assert TARGET in datos and TARGET not in test\n",
        "assert datos[TARGET].notna().all() and set(datos[TARGET].unique()) == {0,1}\n",
        "assert set(datos.columns)-{TARGET} == set(test.columns)\n",
        "assert plantilla.columns.tolist() == ['id',TARGET]\n",
        "for d in [datos,test,plantilla]:\n",
        "    assert d['id'].notna().all() and d['id'].is_unique\n",
        "assert set(datos.id).isdisjoint(set(test.id))\n",
        "assert set(test.id) == set(plantilla.id)\n",
        "for d in [datos,test]:\n",
        "    d['pub_fecha'] = pd.to_datetime(d['pub_fecha'], utc=True, errors='coerce')\n",
        "    assert d.pub_fecha.notna().all(), 'Revisar fechas de publicación inválidas.'\n",
        "assert datos.pub_fecha.max() < test.pub_fecha.min()\n",
        "assert datos.pub_fecha.dt.year.eq(2024).all() and test.pub_fecha.dt.year.eq(2025).all()\n",
        "display(pd.DataFrame([\n",
        "    {'archivo':n,'filas':len(d),'columnas':len(d.columns),'leído':str(rutas[n])}\n",
        "    for n,d in [('train',datos),('test',test),('sample_submission',plantilla)]]))\n",
        "display(pd.DataFrame({'inicio':[datos.pub_fecha.min(),test.pub_fecha.min()],\n",
        "                      'fin':[datos.pub_fecha.max(),test.pub_fecha.max()]},index=['train','test']))"
      ],
