        "## 3. Exploración: clases, faltantes, categorías y montos\n",
        "**Qué observar:** una clase poco frecuente, datos ausentes y valores de gran escala requieren tratamiento específico. Un monto ausente no significa monto cero. Las categorías poco frecuentes no permiten concluir mucho a partir de su porcentaje de desiertas."
      ]
    },
    {
      "cell_type": "code",
      "id": "dcf881f0",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 1000
        },
        "id": "dcf881f0",
        "outputId": "a30345ad-31fb-428e-e96f-e50d40c2b1ec"
      },
      "source": [
        "distribucion = desarrollo[TARGET].value_counts().sort_index().rename('filas').to_frame()\n",
        "distribucion['porcentaje'] = 100*distribucion.filas/len(desarrollo)\n",
        "display(distribucion)\n",
        "faltantes = desarrollo.isna().mean().mul(100).sort_values(ascending=False)\n",
        "display(faltantes[faltantes>0].rename('% faltante').to_frame())\n",
        "display(desarrollo.select_dtypes(include='number').drop(columns=[TARGET],errors='ignore')\n",
        "        .describe(percentiles=[.5,.95,.99]).T)\n",
        "por_mes = desarrollo.assign(mes=desarrollo.pub_fecha.dt.strftime('%Y-%m')).groupby('mes')[TARGET].agg(['size','mean'])\n",
        "fig,ax=plt.subplots(1,2,figsize=(11,3.5))\n",
        "ax[0].bar(['No desierta','Desierta'],distribucion['filas'],color=['#35628c','#d98235'])\n",
        "ax[0].set_title('Clases en desarrollo'); ax[0].set_ylabel('Licitaciones')\n",
        "ax[1].plot(por_mes.index,100*por_mes['mean'],marker='o',color='#35628c')\n",
        "ax[1].set_ylabel('% desiertas'); ax[1].set_title('Evolución enero–agosto')\n",
        "ax[1].tick_params(axis='x',rotation=45)\n",
        "plt.tight_layout(); plt.show()\n",
        "\n",
        "por_modalidad = desarrollo.groupby('pub_modalidad')[TARGET].agg(filas='size',proporcion_desierta='mean')\n",
        "display(por_modalidad.sort_values('filas',ascending=False))\n",
        "resumen_categorias = desarrollo.assign(monto_ausente=desarrollo.pub_monto_estimado.isna()).groupby('pub_categoria').agg(\n",
        "    filas=('id','size'),proporcion_monto_ausente=('monto_ausente','mean'))\n",
        "print('Categorías con al menos 30 filas y todos sus montos ausentes:',\n",
        "      ((resumen_categorias.filas>=30)&(resumen_categorias.proporcion_monto_ausente==1)).sum())\n",
        "print('Combinaciones título + descripción + comprador repetidas:',\n",
        "      desarrollo.duplicated(['pub_titulo','pub_descripcion','comprador_id']).sum())\n",
        "print('Compradores distintos:',desarrollo.comprador_id.nunique())\n",
        "print('Categorías distintas:',desarrollo.pub_categoria_id.nunique())"
      ],
      "execution_count": null,
