      "source": [
        "CORTE_DESARROLLO = pd.Timestamp('2024-09-01',tz='UTC')\n",
        "CORTE_EVALUACION = pd.Timestamp('2024-11-01',tz='UTC')\n",
        "desarrollo = datos[datos.pub_fecha < CORTE_DESARROLLO].copy()\n",
        "calibracion = datos[(datos.pub_fecha >= CORTE_DESARROLLO) &\n",
        "                    (datos.pub_fecha < CORTE_EVALUACION)].copy()\n",
        "evaluacion = datos[datos.pub_fecha >= CORTE_EVALUACION].copy()\n",
        "assert len(desarrollo)+len(calibracion)+len(evaluacion) == len(datos)\n",
        "assert desarrollo.pub_fecha.max() < calibracion.pub_fecha.min()\n",
        "assert calibracion.pub_fecha.max() < evaluacion.pub_fecha.min()\n",
        "display(pd.DataFrame([\n",
        "    {'bloque':n,'filas':len(d),'inicio':d.pub_fecha.min(),'fin':d.pub_fecha.max()}\n",
        "    for n,d in [('Desarrollo',desarrollo),('Umbral final',calibracion),('Evaluación final',evaluacion)]\n",
        "]))"
      ],
