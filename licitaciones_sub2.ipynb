        "assert np.isfinite(p_test).all() and ((p_test>=0)&(p_test<=1)).all()\n",
        "pred_test=(p_test>=umbral_final).astype(int)\n",
        "por_id=pd.Series(pred_test,index=test.id)\n",
        "submission=plantilla[['id']].copy()\n",
        "submission[TARGET]=submission.id.map(por_id)\n",
        "assert submission[TARGET].notna().all()\n",
        "submission[TARGET]=submission[TARGET].astype(int)\n",
        "assert submission.columns.tolist()==plantilla.columns.tolist()\n",
        "assert submission.id.equals(plantilla.id)\n",
        "assert submission.id.is_unique and len(submission)==len(test)\n",
        "assert submission[TARGET].isin([0,1]).all()\n",
        "ARCHIVO_SUBMISSION='submission_licitaciones_nuevo.csv'\n",
        "submission.to_csv(ARCHIVO_SUBMISSION,index=False)\n",
        "display(submission.head())\n",
        "print('Archivo:',ARCHIVO_SUBMISSION,'| Filas:',len(submission))\n",
        "print('Porcentaje predicho como desierta:',round(100*pred_test.mean(),2))\n",
        "\n",
        "# Registro breve para identificar exactamente qué produjo este CSV.\n",
        "registro_final={'seleccion':elegido,'configuraciones':configuraciones_finales,\n",
