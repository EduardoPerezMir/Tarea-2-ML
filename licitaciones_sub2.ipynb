        "    ('sin_tildes',30000,3,(1,2),'unicode'),\n",
        "    ('compacta_15k',15000,3,(1,2),None)]\n",
        "opciones_texto = {f'L_{n}':dict(base_afinada,max_features=m,min_df=d,ngram_range=g,strip_accents=a)\n",
        "                   for n,m,d,g,a in variantes_texto}\n",
        "tabla_texto = comparar(opciones_texto,ventanas,resultados,predicciones,registro)\n",
