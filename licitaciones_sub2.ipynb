      "source": [
        "## 6. Cómo se comparan los resultados\n",
        "- **Precision:** de las licitaciones marcadas como desiertas, cuántas realmente lo fueron.\n",
        "- **Recall:** de todas las desiertas reales, cuántas detectamos.\n",
        "- **F1:** combina precision y recall. Es el criterio principal asumido para este desafío; no es el porcentaje total de aciertos.\n",
        "- **AP (average precision):** resume cómo se ordenan los casos por puntuación, sin fijar un único umbral. Sirve de apoyo y desempate.\n",
        "\n",
        "El modelo genera una puntuación entre 0 y 1. El **umbral** la convierte en 0/1. No suponemos que 0,5 sea lo mejor. Para cada modelo, buscamos el umbral de mayor F1 en su bloque de ajuste y lo aplicamos sin cambios al bloque posterior.\n",
        "\n",
        "Se elige por **F1 medio de junio y agosto**, usando AP medio para desempatar. También se muestran el peor F1 y la variación entre ventanas. Es una búsqueda limitada y secuencial, no una exploración exhaustiva de todas las combinaciones. Se mantiene esta misma regla en todas las fases."
      ]
    },
    {
      "cell_type": "code",
      "id": "015cfd4b",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 175
        },
        "id": "015cfd4b",
        "outputId": "1b5743be-65c0-4065-b547-cb7159de7ce0"
      },
      "source": [
        "def elegir_umbral(y, p):\n",
        "    precision, recall, umbrales = precision_recall_curve(y,p)\n",
        "    f1 = np.divide(2*precision[:-1]*recall[:-1], precision[:-1]+recall[:-1],\n",
        "                   out=np.zeros_like(umbrales), where=(precision[:-1]+recall[:-1])>0)\n",
        "    # Si hay empate exacto, el mayor umbral emite menos alertas.\n",
        "    pos = np.flatnonzero(np.isclose(f1, f1.max(), rtol=0, atol=1e-12))[-1]\n",
        "    return float(umbrales[pos])\n",
        "\n",
        "def medir(y,p,umbral):\n",
        "    pred = np.asarray(p)>=umbral\n",
        "    return dict(f1=f1_score(y,pred,zero_division=0),\n",
        "        precision=precision_score(y,pred,zero_division=0),\n",
        "        recall=recall_score(y,pred,zero_division=0),\n",
        "        ap=average_precision_score(y,p), roc_auc=roc_auc_score(y,p),\n",
        "        accuracy=accuracy_score(y,pred), tasa_predicha=float(pred.mean()))\n",
        "\n",
        "def preparar_ventanas(datos, X):\n",
        "    ventanas=[]\n",
        "    for nombre, a,b,c in [('junio','2024-05-01','2024-06-01','2024-07-01'),\n",
        "                         ('agosto','2024-07-01','2024-08-01','2024-09-01')]:\n",
        "        f=datos['pub_fecha']\n",
        "        partes=[datos.index[f<a], datos.index[(f>=a)&(f<b)], datos.index[(f>=b)&(f<c)]]\n",
        "        ventanas.append({'nombre':nombre,\n",
        "            'X':[X.loc[i] for i in partes],\n",
        "            'y':[datos.loc[i,TARGET].to_numpy() for i in partes]})\n",
        "    return ventanas\n",
        "\n",
        "def clave_prepro(cfg):\n",
        "    campos=['familia','variables','texto','max_features','min_df','ngram_range','strip_accents']\n",
        "    return json.dumps({k:cfg.get(k) for k in campos}, sort_keys=True)\n",
        "\n",
        "def comparar(configs, ventanas, resultados, predicciones, registro):\n",
        "    \"\"\"Cache local: reutiliza matrices para los C que comparten TF-IDF.\"\"\"\n",
        "    filas=[]\n",
        "    cache={}\n",
        "    for nombre,cfg in configs.items():\n",
        "        registro[nombre]=cfg.copy()\n",
        "        if nombre in predicciones:\n",
        "            continue\n",
        "        predicciones[nombre]=[]\n",
        "        inicio=time.perf_counter()\n",
        "        for v in ventanas:\n",
        "            clave=(v['nombre'],clave_prepro(cfg))\n",
        "            if clave not in cache:\n",
        "                # Una sola representación por ventana en memoria.\n",
        "                for vieja in list(cache):\n",
        "                    if vieja[0]==v['nombre']: del cache[vieja]\n",
        "                pre, nnum,ncat=crear_preprocesador(cfg)\n",
        "                A=pre.fit_transform(v['X'][0])\n",
        "                B=pre.transform(v['X'][1]); D=pre.transform(v['X'][2])\n",
        "                cache[clave]=(A,B,D,nnum,ncat)\n",
        "            A,B,D,nnum,ncat=cache[clave]\n",
        "            modelo=crear_clasificador(cfg,nnum,ncat)\n",
        "            with threadpool_limits(limits=N_HILOS):\n",
        "                modelo.fit(A,v['y'][0])\n",
        "                p_umbral=modelo.predict_proba(B)[:,1]\n",
        "                p_eval=modelo.predict_proba(D)[:,1]\n",
        "            t=elegir_umbral(v['y'][1],p_umbral)\n",
        "            fila={'modelo':nombre,'ventana':v['nombre'],'umbral':t,**medir(v['y'][2],p_eval,t)}\n",
        "            filas.append(fila)\n",
        "            predicciones[nombre].append((p_umbral,p_eval))\n",
        "        print(f'{nombre}: F1 medio={np.mean([r[\"f1\"] for r in filas if r[\"modelo\"]==nombre]):.4f}; '\n",
        "              f'{time.perf_counter()-inicio:.1f} s',flush=True)\n",
        "    resultados.extend(filas)\n",
        "    cache.clear(); gc.collect()\n",
        "    return resumir(resultados,list(configs))\n",
        "\n",
        "def resumir(resultados,nombres=None):\n",
        "    d=pd.DataFrame(resultados)\n",
        "    if nombres is not None: d=d[d.modelo.isin(nombres)]\n",
        "    tabla=d.groupby('modelo',sort=False).agg(\n",
        "        f1_medio=('f1','mean'),f1_minimo=('f1','min'),f1_desv=('f1','std'),\n",
        "        ap_medio=('ap','mean'),precision_media=('precision','mean'),recall_medio=('recall','mean'))\n",
        "    return tabla.sort_values(['f1_medio','ap_medio'],ascending=False)\n",
        "\n",
        "ventanas = preparar_ventanas(datos,X)\n",
        "for v in ventanas:\n",
        "    assert all(len(np.unique(y))==2 for y in v['y'])\n",
        "resultados, predicciones, registro = [], {}, {}\n",
        "filas_base=[]\n",
        "for v in ventanas:\n",
        "    y=v['y'][2]\n",
        "    for nombre,valor in [('Siempre no desierta',0),('Siempre desierta',1)]:\n",
        "        p=np.full(len(y),float(valor))\n",
        "        filas_base.append({'modelo':nombre,'ventana':v['nombre'],**medir(y,p,.5)})\n",
        "display(pd.DataFrame(filas_base)[['modelo','ventana','f1','accuracy','precision','recall']])"
      ],
      "execution_count": null,
      "outputs": [
        {
